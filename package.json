{
  "name": "overgarden-web",
  "version": "0.1.0",
  "private": true,
  "description": "Overgarden HTML5 web port + e2e balancing harness.",
  "type": "module",
  "scripts": {
    "e2e": "node tests/e2e/run.mjs",
    "e2e:easy": "node tests/e2e/run.mjs --players 1",
    "e2e:insane": "node tests/e2e/run.mjs --players 4",
    "sweep": "node tests/e2e/sweep.mjs",
    "sweep:prod": "node tests/e2e/sweep.mjs --mode production",
    "sweep:insane": "node tests/e2e/sweep.mjs --players 4",
    "coop": "node tests/e2e/coop.mjs",
    "server": "node server/server.mjs"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "playwright": "^1.49.0"
  }
}
